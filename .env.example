# TeslaLab AI — Environment Variables Reference

# Backend (backend/.env)
FASTAPI_STATE_SECRET=teslalab_dev_state_secret_123456789
FRONTEND_URL=http://localhost:3000
OPENAI_API_KEY=your_openai_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
GITHUB_APP_SLUG=teslalab-ai
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MSG91 Configuration (for Phone OTP on Registration)
# 1. Obtain Auth Key from MSG91 Dashboard -> Settings -> API Keys
MSG91_AUTH_KEY=your_msg91_authkey_here
# 2. Approved DLT/Flow OTP Template ID from MSG91 Dashboard -> OTP -> Templates
MSG91_TEMPLATE_ID=your_msg91_otp_template_id_here
# 3. (Optional) Approved 6-character sender ID header (e.g. TSLLAB)
MSG91_SENDER_ID=your_sender_id_here
# 4. Timer expiry for OTP in seconds (defaults to 60 seconds = 1 minute)
MSG91_OTP_EXPIRY_SECONDS=60
# 5. OTP digit length (default: 6)
MSG91_OTP_LENGTH=6

# Frontend (frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
