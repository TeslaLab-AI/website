{
  "additionalProperties": false,
  "properties": {
    "step_number": {
      "description": "Step sequence number",
      "minimum": 1,
      "title": "Step Number",
      "type": "integer"
    },
    "tool_name": {
      "description": "Tool that was executed",
      "enum": [
        "read_file",
        "search_code",
        "apply_patch",
        "run_tests",
        "run_command",
        "open_pr"
      ],
      "title": "Tool Name",
      "type": "string"
    },
    "success": {
      "description": "Whether the step completed successfully",
      "title": "Success",
      "type": "boolean"
    },
    "output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Standard output or result payload",
      "title": "Output"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error message if step failed",
      "title": "Error"
    },
    "artifacts": {
      "additionalProperties": true,
      "description": "Artifacts or outputs generated by the step",
      "title": "Artifacts",
      "type": "object"
    }
  },
  "required": [
    "step_number",
    "tool_name",
    "success"
  ],
  "title": "StepOutcome",
  "type": "object"
}